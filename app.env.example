# ─────────────────────────────────────────────────────────────────────────────
# Liftoff app definition — every supported variable, with its default.
# Copy this to apps/<your-app>.env and keep only what you need.
#
# Values can also come straight from the environment; exported variables
# override the file:  APP_URL=http://localhost:5000 liftoff run apps/my.env
#
# Relative paths are resolved from this file's folder. "~/" works too.
# This file is sourced by bash, so quote values that contain spaces.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
APP_NAME="My App"                 # required
# APP_MODE=folder                 # folder | container (default: container if DOCKER_IMAGE is set)
# APP_URL=http://localhost:3000   # waited on, then opened in the browser
# APP_ICON=~/Pictures/my-app.png  # image file, image URL, or theme icon name
# APP_BROWSER=xdg-open            # e.g. brave-browser, "firefox --new-window"
# APP_OPEN_BROWSER=true
# APP_WAIT_TIMEOUT=180            # seconds to wait for APP_URL before giving up
# APP_TERMINAL=true               # show a terminal with logs (closing it stops the app)
# APP_DESKTOP_SHORTCUT=true       # `liftoff install` also puts an icon on the desktop
# APP_SLUG=my-app                 # internal id (default: derived from APP_NAME)

# ── Folder mode: run from a project directory ────────────────────────────────
# APP_DIR=~/code/my-app           # required in folder mode
# APP_INSTALL=auto                # auto (only when deps changed) | always | never
# APP_INSTALL_CMD=                # override the detected install command
# APP_START_CMD=                  # override the detected start command
# APP_NODE_VERSION=24.6.0         # use this nvm-installed Node

# ── Container mode: run an image from a registry ─────────────────────────────
# DOCKER_IMAGE=ghcr.io/me/my-app:latest   # required in container mode
# DOCKER_REGISTRY=                # default: taken from DOCKER_IMAGE, else Docker Hub
# DOCKER_USERNAME=                # set to log in before pulling
# DOCKER_PASSWORD=                # token/password (chmod 600 this file!)
# DOCKER_PASSWORD_FILE=           # or read the token from a file instead
# DOCKER_PORTS="3000:3000"        # space-separated host:container pairs
# DOCKER_VOLUMES="~/data:/data"   # space-separated host:container pairs
# DOCKER_ENV_FILE=                # env file passed to the container
# DOCKER_ARGS=                    # extra `docker run` flags, e.g. "--network host"
# DOCKER_COMMAND=                 # override the image's command
# DOCKER_PULL=missing             # always | missing | never
# DOCKER_CONTAINER=liftoff-my-app # container name
# DOCKER_STOP_ON_EXIT=true        # stop the container when Liftoff exits
