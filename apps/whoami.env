# Demo — a tiny public image from Docker Hub, no login needed.
APP_NAME=Whoami
DOCKER_IMAGE=traefik/whoami:v1.10
DOCKER_PORTS="8088:80"
APP_URL=http://localhost:8088
APP_ICON=https://raw.githubusercontent.com/docker-library/docs/master/docker/logo.png

# A private image works the same way, plus credentials:
#   DOCKER_IMAGE=ghcr.io/<user>/<app>:latest
#   DOCKER_USERNAME=<user>
#   DOCKER_PASSWORD_FILE=~/.secrets/ghcr-token
